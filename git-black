#!/usr/bin/env python3
import sys

def perr(line):
  sys.stderr.write(line)
  if not line.endswith('\n'):
    sys.stderr.write('\n')
  sys.stderr.flush()

def main():
  try:
    # Top-level dispatch. blackgitagent and blackgitcli are two independent
    # modules and never import each other; only this entry knows both.
    # - `git black` (no args) -> blackgitagent natural-language REPL
    # - anything else          -> blackgitcli (unknown commands pass to git)
    if len(sys.argv) < 2:
      import blackgitagent
      sys.exit(blackgitagent.main())
    import blackgitcli
    blackw = blackgitcli.BlackGitCli()
    blackw.run(sys.argv)
    return 0
  except Exception as e:
    perr(f"error: {e}")
    return 1

if __name__ == "__main__":
  sys.exit(main())