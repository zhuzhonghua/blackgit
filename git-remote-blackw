#!/usr/bin/env python3
import os
import sys
import socket
import struct
import subprocess
import tempfile
import gitexternalblackw as gitblackw
import blackgit

type_map = {1: "commit", 2: "tree", 3: "blob", 4: "tag"}

def perr(line):
  sys.stderr.write(line)
  if not line.endswith('\n'):
    sys.stderr.write('\n')
  sys.stderr.flush()

def getline():
  return sys.stdin.readline().strip()

class CapabilitiesCommand:
  def __init__(self, blackw):
    self.blackw = blackw

  def run(self):
    bw = self.blackw
    bw.write("fetch\n")
    bw.write("filter\n")
    bw.write("push\n")
    bw.write("list\n")
    bw.write("option\n")
    bw.write("\n")

class ListCommand:
  def __init__(self, blackw):
    self.blackw = blackw

  def run(self, line):
    resp = self.blackw.net.call('list')
    symrefs = []
    refs = []
    for l in resp.decode('utf-8').splitlines():
      l = l.strip()
      if not l:
        continue
      (symrefs if l.startswith('@') else refs).append(l)
    if symrefs:
      perr(f"remote HEAD symrefs: {symrefs}")
    for l in symrefs + refs:
      self.blackw.write(l + '\n')
    self.blackw.write('\n')

class FetchCommand:
  def __init__(self, blackw):
    self.blackw = blackw

  def run(self, line):
    while True:
      sha, ref = self.parsefetch(line)
      perr(f"Fetching {sha} for {ref}")
      body = self.encodefetchrequest([sha])
      pack = self.blackw.net.call('fetch', body)
      self._write_pack(pack)

      perr(f"{line} end")
      line = getline()
      if line == "":
        break
    self.blackw.write("\n")
    perr("[git] fetch end")

  def parsefetch(self, line):
    ftargv = line.split(" ")
    if ftargv[1].startswith("--filter="):
      sha = ftargv[2]
      ref = ftargv[3]
    else:
      sha = ftargv[1]
      ref = ftargv[2]
    return (sha, ref)

  def encodefetchrequest(self, shas):
    text = "\n".join(shas)
    return text.encode('utf-8')

  def _write_pack(self, pack):
    tmp = tempfile.NamedTemporaryFile(suffix='.pack', delete=False)
    try:
      tmp.write(pack)
      tmp.close()
      self.blackw.run_cmd(["git", "index-pack", "--stdin", "--promisor"], stdin=pack)
    finally:
      os.unlink(tmp.name)

class OptionCommand:
  def __init__(self, blackw):
    self.blackw = blackw

  def run(self, line):
    bw = self.blackw
    if line.startswith("option verbosity"):
      bw.write("ok\n")
    elif line.startswith("option filter"):
      bw.write("ok\n")
    elif line.startswith("option from-promisor"):
      bw.write("ok\n")
    elif line.startswith("option progress"):
      bw.write("ok\n")
    elif line.startswith("option check-connectivity"):
      bw.write("unsupported\n")
    elif line.startswith("option update-shallow"):
      bw.write("ok\n")
    else:
      bw.write("unsupported\n")

class RemoteBlackW:
  def __init__(self):
    self.net = blackgit.Net()

  def run(self):
    try:
      self._run()
    except Exception as e:
      perr(f"Error: {e}")
      raise
    finally:
      self.net.close()

  def _run(self):
    while True:
      line = getline()
      if line == "":
        break
      perr(f"[git] {line}")
      if line == "capabilities":
        CapabilitiesCommand(self).run()
      elif line.startswith("list"):
        ListCommand(self).run(line)
      elif line.startswith("fetch"):
        FetchCommand(self).run(line)
      elif line.startswith("option"):
        OptionCommand(self).run(line)
      else:
        perr(f"[git] unsupported operation: {line}")
        sys.exit(1)

  def run_cmd(self, cmd, *arg, stdin=None, **args):
    perr(f"run={cmd}")
    with subprocess.Popen(cmd,
                          stdout=subprocess.PIPE,
                          stderr=subprocess.PIPE,
                          stdin=subprocess.PIPE if stdin else None,
                          *arg, **args) as p:
      out, err = p.communicate(stdin)
      if out:
        perr(out.decode().strip())
      if err:
        perr(err.decode().strip())
      if p.returncode != 0:
        raise Exception(err.decode().strip())
      return out.decode().strip() if out else ""

  def write(self, message):
    sys.stdout.write(message)
    sys.stdout.flush()

def main():
  try:
    perr(f"argv={sys.argv}")
    if sys.argv[0].endswith("git-blackw"):
      blackw = gitblackw.ExternalBlackW()
      blackw.run(sys.argv)
    else:
      blackw = RemoteBlackW()
      blackw.run()
    return 0
  except Exception as e:
    perr(f"unexpected exception {e}")
    raise
  except KeyboardInterrupt:
    sys.exit(1)

if __name__ == "__main__":
  sys.exit(main())
